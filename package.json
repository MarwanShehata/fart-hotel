{
  "name": "fart-hotel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --apply .",
    "prepare": "husky",
    "pre-push": "bun run lint && bun run typecheck && bun run format --check",
    "test": "echo \"No tests yet\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "husky": "^9.1.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "ultracite": "5.0.31",
    "vite": "^6.3.5"
  }
}
